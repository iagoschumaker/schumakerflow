# ==========================================
# Schumaker Flow — Environment Configuration
# ==========================================

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schumaker_flow?schema=public"

# Auth - JWT Secret (generate a strong random string)
JWT_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_STRING_AT_LEAST_32_CHARS"
JWT_EXPIRES_IN="7d"

# Google Drive - Service Account
GOOGLE_SERVICE_ACCOUNT_JSON=""
# OR path to the JSON file:
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH="./google-service-account.json"

# Mercado Pago - PIX Integration
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""

# Email / SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@schumakerflow.com"

# Application
BASE_URL="http://localhost:3000"
TENANT_DOMAIN="localhost" # In production: schumakerflow.com
NODE_ENV="development"

# Cron Secret (for securing cron API routes)
CRON_SECRET="CHANGE_ME_TO_A_RANDOM_STRING"

# Briefings module
# NEXT_PUBLIC_BRIEFINGS_ENABLED é build-time (client): controla só se o item de menu aparece.
# Mudar no .env da VPS exige rebuild (npm run build), não basta reiniciar o processo.
# BRIEFINGS_ENABLED é runtime (server): controla o acesso de verdade nas rotas admin e na pública.
NEXT_PUBLIC_BRIEFINGS_ENABLED="false"
BRIEFINGS_ENABLED="false"
# Chave de criptografia dos links de briefing (AES-256-GCM), 32 bytes em base64.
# Gere com: openssl rand -base64 32
# Obrigatória sempre que BRIEFINGS_ENABLED="true" — sem ela o servidor falha ao subir
# (ver src/instrumentation.ts). Nunca reaproveite entre ambientes.
BRIEFINGS_TOKEN_KEY=""
# Fuso horário só para EXIBIR instantes (submittedAt, createdAt, eventos) --
# datas puras (referenceMonth, dueDate, campos tipo "data") nunca usam isso,
# são strings "aaaa-mm-dd" tratadas manualmente. Precisa das duas variáveis
# com o MESMO valor: a sem NEXT_PUBLIC_ para páginas renderizadas no servidor,
# a com NEXT_PUBLIC_ para o indicador de autosave (renderizado no navegador).
# Default se não setar: America/Sao_Paulo.
APP_TIMEZONE="America/Sao_Paulo"
NEXT_PUBLIC_APP_TIMEZONE="America/Sao_Paulo"
