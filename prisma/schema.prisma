// Schumaker Flow — Full Database Schema
// Multi-tenant SaaS: Client, Media & Finance Management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum UserRole {
  SUPERADMIN
  TENANT_ADMIN
  TENANT_STAFF
  CLIENT_USER
}

enum FileKind {
  PREVIEW
  FINAL
  RAW
  OTHER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum ProjectStatus {
  DRAFT
  IN_PRODUCTION
  IN_REVIEW
  DELIVERED
  ARCHIVED
}

// FileKind moved up

enum DownloadStatus {
  STARTED
  COMPLETED
  FAILED
}

enum ContractType {
  MONTHLY
  PER_VIDEO
  PER_PROJECT
  ONE_OFF
}

enum ContractStatus {
  ACTIVE
  PAUSED
  CANCELLED
  FINISHED
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum InvoiceItemType {
  MONTHLY_FEE
  VIDEO
  PROJECT
  ONE_OFF
}

enum ExpenseCategory {
  SOFTWARE
  EQUIPMENT
  MARKETING
  OFFICE
  SALARY
  FREELANCER
  TAX
  OTHER
}

enum PaymentMethod {
  PIX
  MANUAL
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum BlockMode {
  BLOCK_FINAL_ONLY
  BLOCK_ALL
}

enum NotificationType {
  INVOICE_REMINDER
  INVOICE_OVERDUE
  WELCOME
  PASSWORD_RESET
  FILE_PUBLISHED
  DOWNLOAD_BLOCKED
  WHATSAPP_REMINDER
  WHATSAPP_DUE_TODAY
  WHATSAPP_OVERDUE
}

enum JobStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

// ==================== GLOBAL MODELS ====================

model Tenant {
  id                String       @id @default(uuid())
  name              String
  slug              String       @unique
  subdomain         String?      @unique
  status            TenantStatus @default(ACTIVE)
  driveRootFolderId String?
  driveRefreshToken String?
  driveAccessToken  String?
  driveTokenExpiry  DateTime?
  driveEmail        String?
  // Subscription / Plan
  plan              String? // e.g. "free", "starter", "pro"
  maxProjects       Int? // null = unlimited
  maxUsers          Int? // null = unlimited
  featureFinance    Boolean      @default(true)
  // Evolution API (WhatsApp)
  evolutionInstance String?
  // Billing/block config
  blockAfterDays    Int          @default(7)
  blockMode         BlockMode    @default(BLOCK_FINAL_ONLY)
  videoBillingMode  String       @default("CONSOLIDATED") // CONSOLIDATED | PER_DELIVERY
  currency          String       @default("BRL")
  // Mercado Pago
  mpAccessToken     String?
  // PIX settings
  pixKey            String?
  pixKeyType        String? // CPF, CNPJ, EMAIL, PHONE, RANDOM
  pixReceiverName   String?
  // Branding
  logoUrl           String?
  primaryColor      String?      @default("#6366f1")
  // Timestamps
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  members             TenantMember[]
  clients             Client[]
  projects            Project[]
  files               File[]
  downloadEvents      DownloadEvent[]
  contracts           Contract[]
  invoices            Invoice[]
  payments            Payment[]
  notificationLogs    NotificationLog[]
  auditLogs           AuditLog[]
  clientAccess        ClientAccess[]
  expenses            Expense[]
  shareLinks          ShareLink[]
  // Briefings
  briefingTemplates   BriefingTemplate[]
  briefingCycles      BriefingCycle[]
  briefingClientLists BriefingClientList[]

  @@index([slug])
  @@index([subdomain])
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String
  isSuperAdmin    Boolean   @default(false)
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  resetToken      String?
  resetTokenExp   DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  tenantMembers TenantMember[]
  clientAccess  ClientAccess[]

  @@index([email])
}

model TenantMember {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String
  role        UserRole // TENANT_ADMIN or TENANT_STAFF
  permissions String? // JSON string with granular permissions
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

model HolidayCalendar {
  id        String   @id @default(uuid())
  date      DateTime
  name      String
  country   String   @default("BR")
  state     String? // UF for regional holidays
  createdAt DateTime @default(now())

  @@unique([date, country, state])
  @@index([country, state])
}

model JobRun {
  id             String    @id @default(uuid())
  jobName        String
  tenantId       String?
  status         JobStatus
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  details        String? // JSON with extra info
  error          String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())

  @@index([jobName])
  @@index([tenantId])
  @@index([idempotencyKey])
}

// ==================== TENANT-SCOPED MODELS ====================

model Client {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  email         String?
  phone         String?
  notes         String?
  driveFolderId String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projects            Project[]
  clientAccess        ClientAccess[]
  contracts           Contract[]
  invoices            Invoice[]
  instagramAccounts   ClientInstagram[]
  briefingCycles      BriefingCycle[]
  briefingClientLists BriefingClientList[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model ClientInstagram {
  id          String   @id @default(uuid())
  clientId    String
  accessToken String
  igUserId    String
  username    String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([igUserId])
}

model ClientAccess {
  id        String   @id @default(uuid())
  userId    String
  tenantId  String
  clientId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  downloadEvents DownloadEvent[]

  @@unique([userId, tenantId, clientId])
  @@index([userId])
  @@index([tenantId])
  @@index([clientId])
}

model Project {
  id                   String        @id @default(uuid())
  tenantId             String
  clientId             String
  name                 String
  description          String?
  status               ProjectStatus @default(DRAFT)
  driveFolderId        String?
  drivePreviewFolderId String?
  driveFinalFolderId   String?
  driveRawFolderId     String?
  driveOtherFolderId   String?
  deliveredAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client     Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  files      File[]
  shareLinks ShareLink[]

  @@index([tenantId])
  @@index([clientId])
  @@index([status])
}

model File {
  id            String    @id @default(uuid())
  tenantId      String
  projectId     String
  name          String
  kind          FileKind
  driveFileId   String?
  driveFolderId String?
  mimeType      String?
  sizeBytes     BigInt?
  md5Hash       String?
  isVisible     Boolean   @default(false)
  publishedAt   DateTime?
  tags          String? // JSON array
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  downloadEvents DownloadEvent[]
  invoiceItems   InvoiceItem[]
  shareLinks     ShareLink[]

  @@index([tenantId])
  @@index([projectId])
  @@index([kind])
  @@index([publishedAt])
}

model DownloadEvent {
  id             String         @id @default(uuid())
  tenantId       String
  fileId         String
  clientAccessId String
  status         DownloadStatus
  ip             String?
  userAgent      String?
  bytesSent      BigInt?
  startedAt      DateTime       @default(now())
  completedAt    DateTime?

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  file         File         @relation(fields: [fileId], references: [id], onDelete: Cascade)
  clientAccess ClientAccess @relation(fields: [clientAccessId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([fileId])
  @@index([clientAccessId])
  @@index([startedAt])
}

// ==================== FINANCIAL MODELS ====================

model Contract {
  id               String         @id @default(uuid())
  tenantId         String
  clientId         String
  type             ContractType
  status           ContractStatus @default(ACTIVE)
  name             String
  description      String?
  // Pricing
  monthlyAmount    Decimal?       @db.Decimal(10, 2)
  perVideoAmount   Decimal?       @db.Decimal(10, 2)
  perProjectAmount Decimal?       @db.Decimal(10, 2)
  oneOffAmount     Decimal?       @db.Decimal(10, 2)
  currency         String         @default("BRL")
  // Billing config
  billingDay       Int?           @default(5) // nth business day
  startDate        DateTime
  endDate          DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([tenantId])
  @@index([clientId])
  @@index([type])
  @@index([status])
}

model Invoice {
  id                String        @id @default(uuid())
  tenantId          String
  clientId          String
  contractId        String?
  // Dates
  dueDate           DateTime
  paidAt            DateTime?
  // Amounts
  totalAmount       Decimal       @db.Decimal(10, 2)
  currency          String        @default("BRL")
  // Status
  status            InvoiceStatus @default(PENDING)
  // PIX data
  pixPayload        String? // copia e cola
  pixQrCode         String? // base64 QR
  // External provider
  externalProvider  String?       @default("mercado_pago")
  externalReference String?       @unique
  // Meta
  notes             String?
  proofUrl          String? // comprovante
  referenceMonth    String? // "2026-03" for monthly
  // Idempotency
  idempotencyKey    String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client   Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contract Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  items    InvoiceItem[]
  payments Payment[]

  @@index([tenantId])
  @@index([clientId])
  @@index([contractId])
  @@index([status])
  @@index([dueDate])
  @@index([referenceMonth])
}

model InvoiceItem {
  id          String          @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int             @default(1)
  unitPrice   Decimal         @db.Decimal(10, 2)
  totalAmount Decimal         @db.Decimal(10, 2)
  type        InvoiceItemType
  fileId      String? // for PER_VIDEO billing

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  file    File?   @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model Payment {
  id                String        @id @default(uuid())
  tenantId          String
  invoiceId         String
  method            PaymentMethod @default(PIX)
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("BRL")
  // External
  transactionId     String?
  externalReference String?
  // PIX specific
  pixPayload        String?
  pixQrCodeBase64   String?
  // Meta
  confirmedAt       DateTime?
  rawWebhookData    String? // JSON
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@index([transactionId])
  @@index([status])
}

// ==================== SYSTEM MODELS ====================

model NotificationLog {
  id             String           @id @default(uuid())
  tenantId       String
  type           NotificationType
  recipientEmail String
  subject        String?
  body           String?
  invoiceId      String?
  sentAt         DateTime         @default(now())
  success        Boolean          @default(true)
  error          String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([type])
  @@index([invoiceId])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String // e.g. "project.create", "file.publish", "invoice.create"
  entityType String? // e.g. "Project", "File", "Invoice"
  entityId   String?
  details    String? // JSON
  ip         String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model PlanTemplate {
  id             String   @id @default(uuid())
  name           String   @unique
  slug           String?  @unique
  displayName    String   @default("")
  description    String?
  maxProjects    Int?
  maxUsers       Int?
  featureFinance Boolean  @default(true)
  price          Float    @default(0)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ShareLink {
  id            String    @id @default(uuid())
  token         String    @unique
  fileId        String?
  projectId     String?
  tenantId      String?
  label         String?
  createdById   String?
  expiresAt     DateTime?
  password      String?
  maxViews      Int?
  viewCount     Int       @default(0)
  downloadCount Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  file    File?    @relation(fields: [fileId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([fileId])
  @@index([projectId])
  @@index([tenantId])
}

// ==================== EXPENSE ====================

enum ExpenseStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model Expense {
  id             String          @id @default(uuid())
  tenantId       String
  description    String
  amount         Decimal         @db.Decimal(10, 2)
  category       ExpenseCategory @default(OTHER)
  date           DateTime
  dueDate        DateTime?
  paidAt         DateTime?
  status         ExpenseStatus   @default(PENDING)
  referenceMonth String? // "2026-03"
  notes          String?
  recurring      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([date])
  @@index([referenceMonth])
  @@index([status])
}

// ==================== BRIEFINGS ====================

enum BriefingTemplateSectionKind {
  single
  repeater
}

enum BriefingTemplateFieldType {
  text
  textarea
  date
  month
  time
  money
  number
  select
  boolean
  email
  phone
  url
  multi_select
  client_list
}

// Optional semantic tag a field can carry so CONFERIR rules can reason about
// *what a field means* instead of matching on its key -- keeps every rule
// generic across tenants/templates instead of hardcoding one client's
// vocabulary. Field with no role just gets the basic checks.
enum BriefingTemplateFieldRole {
  period_start
  period_end
  event_date
  launch_date
  production_date
  scope
  priority
  needs_promotion
  details
}

enum BriefingTemplateFieldWidth {
  half
  full
}

enum BriefingCycleStatus {
  draft
  sent
  in_progress
  submitted
  archived
}

model BriefingTemplate {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sections BriefingTemplateSection[]
  cycles   BriefingCycle[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("briefing_templates")
}

model BriefingTemplateSection {
  id                String                      @id @default(uuid())
  templateId        String
  title             String
  description       String?
  kind              BriefingTemplateSectionKind
  repeaterItemLabel String?
  emptyLabel        String?
  minItems          Int?
  maxItems          Int?
  isOptional        Boolean                     @default(false)
  sortOrder         Int

  template BriefingTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  fields   BriefingTemplateField[]

  @@index([templateId])
  @@map("briefing_template_sections")
}

model BriefingTemplateField {
  id          String                     @id @default(uuid())
  sectionId   String
  key         String
  label       String
  hint        String?
  placeholder String?
  type        BriefingTemplateFieldType
  role        BriefingTemplateFieldRole?
  options     Json?
  isRequired  Boolean                    @default(false)
  isActive    Boolean                    @default(true)
  width       BriefingTemplateFieldWidth @default(half)
  sortOrder   Int

  section BriefingTemplateSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  answers BriefingAnswer[]

  @@unique([sectionId, key])
  @@index([sectionId])
  @@map("briefing_template_fields")
}

model BriefingCycle {
  id             String              @id @default(uuid())
  tenantId       String
  clientId       String
  templateId     String
  referenceMonth DateTime            @db.Date
  title          String?
  status         BriefingCycleStatus @default(draft)
  dueDate        DateTime?           @db.Date
  submittedAt    DateTime?
  archivedAt     DateTime?
  createdBy      String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client   Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template BriefingTemplate @relation(fields: [templateId], references: [id])
  links    BriefingLink[]
  answers  BriefingAnswer[]
  events   BriefingEvent[]

  @@unique([tenantId, clientId, templateId, referenceMonth])
  @@index([tenantId, status])
  @@index([tenantId, referenceMonth])
  @@index([clientId])
  @@map("briefing_cycles")
}

model BriefingLink {
  id           String    @id @default(uuid())
  cycleId      String
  tokenEnc     String // AES-256-GCM: base64(iv || authTag || ciphertext). Recoverable for "Mostrar link".
  tokenLookup  String    @unique // SHA-256(token) hex — only used for the public route's WHERE lookup.
  tokenPreview String
  expiresAt    DateTime
  revokedAt    DateTime?
  opensCount   Int       @default(0)
  lastOpenedAt DateTime?

  cycle BriefingCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([tokenLookup])
  @@index([cycleId])
  @@map("briefing_links")
}

model BriefingAnswer {
  id         String   @id @default(uuid())
  cycleId    String
  fieldId    String
  groupIndex Int      @default(0)
  value      Json
  updatedAt  DateTime @updatedAt

  cycle BriefingCycle         @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  field BriefingTemplateField @relation(fields: [fieldId], references: [id])

  @@unique([cycleId, fieldId, groupIndex])
  @@index([cycleId])
  @@map("briefing_answers")
}

// A named list that belongs to a client (locations, practice areas, product
// lines -- whatever the client's own stable entities are) so form fields can
// reference it by key instead of the client typing free text every month.
model BriefingClientList {
  id        String   @id @default(uuid())
  tenantId  String
  clientId  String
  key       String // "unidades", "areas", "linhas" -- matched against a CLIENT_LIST field's options.listKey
  name      String // "Unidades", "Áreas de atuação"
  items     Json // string[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, clientId, key])
  @@index([tenantId, clientId])
  @@map("briefing_client_lists")
}

model BriefingEvent {
  id        String   @id @default(uuid())
  cycleId   String
  type      String
  ipHash    String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  cycle BriefingCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId])
  @@map("briefing_events")
}
